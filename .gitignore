# 依赖与构建产物
node_modules/
dist/
*.tsbuildinfo

# tsconfig.node.json 缺 noEmit，tsc -b 会把 vite.config.ts 编成这两个文件。
# Vite 解析配置时 .js 优先于 .ts，留在库里会导致改了 .ts 却不生效。
vite.config.js
vite.config.d.ts

# 截图裁切等本地中间产物
.tmp/

# 备份与调试残留
*.bak

# 编辑器与系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# KC-Chat 运行时产物（插件自动生成，请勿入库）
.cursor/mcp.json
.cursor/kc-mcp/
.cursor/kc-mcp-messages/
.cursor/kc-chat-exports/
